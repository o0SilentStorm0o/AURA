<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:debuggable="true"
        android:label="Fixture Bank Debug"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".ExportedSyncService"
            android:exported="true" />

        <receiver
            android:name=".ExportedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.example.leakybank.SYNC_NOW" />
            </intent-filter>
        </receiver>

        <provider
            android:name=".ExportedProvider"
            android:authorities="com.example.leakybank.provider"
            android:exported="true" />
    </application>
</manifest>
