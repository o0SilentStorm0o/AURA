<?xml version="1.0" encoding="utf-8"?><!--
   AURA disables backup in AndroidManifest.xml. Keep this file minimal so it
   does not carry default template notes if the resource is inspected during review.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
